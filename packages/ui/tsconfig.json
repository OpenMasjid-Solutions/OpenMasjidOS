{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "useDefineForClassFields": true,
    "baseUrl": ".",
    "paths": {
      // Resolve the core's AppRouter TYPE straight from source rather than via
      // the workspace symlink in node_modules. npm workspaces link packages with
      // symlinks, and those don't survive every checkout (an SMB/network share,
      // a zip export, some CI caches) — when the link is missing, `AppRouter`
      // silently resolves to `any` and the tRPC client collapses into tRPC's
      // "collides with a built-in method" error-string union, showering ~170
      // bogus errors across every file that touches `trpc.*`. Pointing at the
      // file directly makes the typecheck reproducible everywhere.
      // Still TYPES ONLY (CLAUDE.md §7) — Vite bundles nothing from here.
      "@openmasjid/core": ["../core/src/trpc/router.ts"],
      // The shadcn CLI writes `@/lib/cn` and `@/components/ui/...` imports into
      // every component it adds, and those paths are baked into the generated
      // source rather than configurable per import. The alias must therefore
      // exist in BOTH tsconfig (for the typecheck, which is our only lint) and
      // vite.config.ts (for the bundle) or added components fail to resolve in
      // one of the two and the mismatch shows up as a green build with a blank
      // page. Keep the two in step.
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["dist", "node_modules"]
}
