{
  "name": "@openmasjid/ui",
  "version": "0.2.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "//exports": [
    "The design-system surface other OpenMasjid apps consume. Source is exported, not a",
    "build: every app in the fleet is Vite + TypeScript, so shipping .ts/.css avoids a",
    "build step here and a stale-artifact class of bug entirely.",
    "The dashboard's own entry points (main.tsx, App.tsx, routes/) are deliberately NOT",
    "exported — they are OpenMasjidOS features, not a design system.",
    "`private: true` stays until publishing is a decision someone has actually taken."
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/design-system.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./ui-manifest.json": "./ui-manifest.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/space-grotesk": "^5.1.0",
    "@openmasjid/core": "*",
    "@tanstack/react-query": "^5.59.16",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "i18next": "^23.16.4",
    "lucide-react": "^0.460.0",
    "motion": "^11.11.17",
    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  }
}
